{
  "expo": {
    "newArchEnabled": true,
    "name": "YuSay",
    "slug": "yusay",
    "scheme": "yusay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#534AB7"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.yusay.app",
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.yusay.app"
        ]
      },
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "음성으로 일정을 등록하기 위해 필요합니다.",
        "NSMicrophoneUsageDescription": "음성으로 일정을 등록하기 위해 필요합니다."
      }
    },
    "android": {
      "package": "com.yusay.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#534AB7"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "./plugins/withYuSayWidgets",
      "@react-native-community/datetimepicker"
    ],
    "jsEngine": "hermes"
  }
}
