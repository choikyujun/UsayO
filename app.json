{
  "expo": {
    "newArchEnabled": true,
    "name": "UsayO",
    "slug": "usayo",
    "scheme": "yusay",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/9445a9bd-143d-4898-bed5-002da3a4315b"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#534AB7"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.yusay.app",
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.yusay.app"
        ]
      },
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "음성으로 일정을 등록하기 위해 필요합니다.",
        "NSMicrophoneUsageDescription": "음성으로 일정을 등록하기 위해 필요합니다."
      }
    },
    "android": {
      "package": "com.yusay.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#534AB7"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "./plugins/withYuSayWidgets",
      "./plugins/withRemovePermissions",
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "jsEngine": "hermes",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9445a9bd-143d-4898-bed5-002da3a4315b"
      }
    },
    "owner": "huwoorin"
  }
}
