{
  "expo": {
    "newArchEnabled": true,
    "name": "UsayO",
    "slug": "usayo",
    "scheme": "usayo",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/9445a9bd-143d-4898-bed5-002da3a4315b"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#534AB7"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.usayo.app",
      "icon": "./assets/icon.png",
      "supportsTablet": false,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "녹음한 음성을 글자로 바꿔 일정의 제목과 시각을 알아듣기 위해 사용합니다.",
        "NSMicrophoneUsageDescription": "말로 일정을 추가·변경·조회할 때 음성을 녹음하기 위해 마이크를 사용합니다.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.usayo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#534AB7"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "./plugins/withYuSayWidgets",
      "./plugins/withRemovePermissions",
      "@react-native-community/datetimepicker",
      "expo-font",
      "react-native-iap"
    ],
    "jsEngine": "hermes",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9445a9bd-143d-4898-bed5-002da3a4315b"
      }
    },
    "owner": "huwoorin"
  }
}
