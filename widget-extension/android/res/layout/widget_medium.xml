<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="horizontal"
  android:background="#0E0C1F"
  android:padding="10dp">

  <!-- Left: FAB + count -->
  <LinearLayout
    android:layout_width="76dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center">

    <ImageView
      android:id="@+id/widget_fab"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:src="@drawable/ic_mic"
      android:background="@drawable/widget_fab_background"
      android:padding="11dp"
      android:layout_marginBottom="6dp" />

    <TextView
      android:id="@+id/widget_count"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="18sp"
      android:textStyle="bold"
      android:textColor="#EEEDFE"
      android:text="0" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="10sp"
      android:textColor="#5B5880"
      android:text="개 남음" />

  </LinearLayout>

  <!-- Divider -->
  <View
    android:layout_width="1dp"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="12dp"
    android:background="#18163A" />

  <!-- Right: event list -->
  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="4dp">

    <!-- Empty state -->
    <TextView
      android:id="@+id/widget_empty"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="12sp"
      android:textColor="#5B5880"
      android:text="오늘 일정 없음"
      android:visibility="gone" />

    <!-- Row 1 -->
    <LinearLayout android:id="@+id/event_row_1"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical"
      android:layout_marginBottom="6dp" android:visibility="gone">
      <View android:layout_width="3dp" android:layout_height="32dp"
        android:background="#534AB7" android:layout_marginEnd="8dp" />
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/event_time_1" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#AFA9EC" />
        <TextView android:id="@+id/event_title_1" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#EEEDFE"
          android:maxLines="1" android:ellipsize="end" />
      </LinearLayout>
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout android:id="@+id/event_row_2"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical"
      android:layout_marginBottom="6dp" android:visibility="gone">
      <View android:layout_width="3dp" android:layout_height="32dp"
        android:background="#534AB7" android:layout_marginEnd="8dp" />
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/event_time_2" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#AFA9EC" />
        <TextView android:id="@+id/event_title_2" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#EEEDFE"
          android:maxLines="1" android:ellipsize="end" />
      </LinearLayout>
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout android:id="@+id/event_row_3"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical"
      android:visibility="gone">
      <View android:layout_width="3dp" android:layout_height="32dp"
        android:background="#534AB7" android:layout_marginEnd="8dp" />
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/event_time_3" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#AFA9EC" />
        <TextView android:id="@+id/event_title_3" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#EEEDFE"
          android:maxLines="1" android:ellipsize="end" />
      </LinearLayout>
    </LinearLayout>

  </LinearLayout>
</LinearLayout>
