<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:background="#B8FFFFFF">

  <!-- Header: 오늘 + 날짜  /  설정·추가·음성 -->
  <LinearLayout
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="14dp" android:paddingEnd="9dp" android:paddingTop="11dp" android:paddingBottom="9dp">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
      android:layout_weight="1" android:orientation="vertical">
      <TextView android:id="@+id/widget_header_title" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="오늘" android:textSize="17sp"
        android:textStyle="bold" android:textColor="#26215C" />
      <TextView android:id="@+id/widget_header_date" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="14.5sp" android:textColor="#6F6B8E" />
    </LinearLayout>

    <ImageView android:id="@+id/widget_btn_settings" android:layout_width="30dp" android:layout_height="30dp"
      android:padding="7dp" android:src="@drawable/ic_settings" android:scaleType="fitCenter" />
    <ImageView android:id="@+id/widget_btn_add" android:layout_width="30dp" android:layout_height="30dp"
      android:layout_marginStart="5dp" android:padding="7dp" android:background="@drawable/widget_ico_ghost"
      android:src="@drawable/ic_add" android:scaleType="fitCenter" />
    <ImageView android:id="@+id/widget_btn_mic" android:layout_width="30dp" android:layout_height="30dp"
      android:layout_marginStart="5dp" android:padding="7dp" android:background="@drawable/widget_fab_background"
      android:src="@drawable/ic_mic_line" android:scaleType="fitCenter" />
  </LinearLayout>

  <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A26215C" />

  <ListView android:id="@+id/widget_list"
    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:divider="@null" android:dividerHeight="0dp" android:scrollbars="none"
    android:paddingTop="2dp" android:paddingBottom="6dp" />

  <TextView android:id="@+id/widget_empty"
    android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:gravity="center" android:textSize="15sp" android:textColor="#9A97AC"
    android:text="일정 없음" android:visibility="gone" />
</LinearLayout>
