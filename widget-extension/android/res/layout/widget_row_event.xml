<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/event_root"
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="horizontal" android:gravity="center_vertical"
  android:paddingStart="14dp" android:paddingEnd="6dp">

  <LinearLayout android:id="@+id/event_body"
    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingTop="6dp" android:paddingBottom="6dp">
    <ImageView android:id="@+id/event_bar" android:layout_width="3dp" android:layout_height="17dp"
      android:background="#534AB7" android:layout_marginEnd="9dp" />
    <!-- 시각 "오전 10:30"(+3sp) 수용 위해 68dp→86dp 확대 -->
    <TextView android:id="@+id/event_time" android:layout_width="86dp" android:layout_height="wrap_content"
      android:textSize="14.5sp" android:textStyle="bold" android:textColor="#55516F"
      android:maxLines="1" android:ellipsize="end" />
    <!-- 제목: 남는 공간 차지(우선), 말줄임 -->
    <TextView android:id="@+id/event_title" android:layout_width="0dp" android:layout_height="wrap_content"
      android:layout_weight="1" android:layout_marginStart="9dp" android:textSize="16sp" android:textColor="#22202E"
      android:maxLines="1" android:ellipsize="end" />
    <!-- 장소(있을 때만): 제목 뒤 회색, 최대 폭 제한 + 말줄임(4x2 좁을 때 제목 우선). +3sp라 폭도 110→130 -->
    <TextView android:id="@+id/event_location" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginStart="7dp" android:maxWidth="130dp" android:textSize="14.5sp" android:textColor="#8A86A3"
      android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
  </LinearLayout>

  <!-- 완료 원 탭 영역. 폭 34dp는 오탭 시 왼쪽 event_body(=앱 열기)로 빠지기 쉬워 44dp로 넓힌다.
       (행 높이는 34dp 유지 — 높이를 키우면 목록에 보이는 항목 수가 줄어든다.)
       event_body가 weight=1이라 넓힌 만큼 제목 영역만 줄어든다. -->
  <FrameLayout android:id="@+id/event_check" android:layout_width="44dp" android:layout_height="34dp">
    <ImageView android:id="@+id/event_check_icon" android:layout_width="18dp" android:layout_height="18dp"
      android:layout_gravity="center" android:src="@drawable/ic_check_empty" />
  </FrameLayout>
</LinearLayout>
