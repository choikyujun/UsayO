<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/event_root"
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="horizontal" android:gravity="center_vertical"
  android:paddingStart="14dp" android:paddingEnd="6dp">

  <LinearLayout android:id="@+id/event_body"
    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingTop="8dp" android:paddingBottom="8dp">
    <ImageView android:id="@+id/event_bar" android:layout_width="3dp" android:layout_height="15dp"
      android:background="#534AB7" android:layout_marginEnd="9dp" />
    <!-- 시각 "오전 9:00" 수용 위해 46dp→68dp 확대 -->
    <TextView android:id="@+id/event_time" android:layout_width="68dp" android:layout_height="wrap_content"
      android:textSize="11.5sp" android:textStyle="bold" android:textColor="#55516F"
      android:maxLines="1" android:ellipsize="end" />
    <!-- 제목: 남는 공간 차지(우선), 말줄임 -->
    <TextView android:id="@+id/event_title" android:layout_width="0dp" android:layout_height="wrap_content"
      android:layout_weight="1" android:layout_marginStart="9dp" android:textSize="13sp" android:textColor="#22202E"
      android:maxLines="1" android:ellipsize="end" />
    <!-- 장소(있을 때만): 제목 뒤 회색, 최대 폭 제한 + 말줄임(4x2 좁을 때 제목 우선) -->
    <TextView android:id="@+id/event_location" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginStart="7dp" android:maxWidth="110dp" android:textSize="11.5sp" android:textColor="#8A86A3"
      android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
  </LinearLayout>

  <FrameLayout android:id="@+id/event_check" android:layout_width="34dp" android:layout_height="34dp">
    <ImageView android:id="@+id/event_check_icon" android:layout_width="18dp" android:layout_height="18dp"
      android:layout_gravity="center" android:src="@drawable/ic_check_empty" />
  </FrameLayout>
</LinearLayout>
