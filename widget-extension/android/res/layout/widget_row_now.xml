<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="horizontal" android:gravity="center_vertical"
  android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="3dp" android:paddingBottom="5dp">
  <ImageView android:layout_width="5dp" android:layout_height="5dp" android:background="@drawable/now_dot" android:layout_marginEnd="8dp" />
  <ImageView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#73E5484D" />
  <TextView android:id="@+id/now_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:layout_marginStart="8dp" android:textSize="13sp" android:textStyle="bold" android:textColor="#E5484D" />
</LinearLayout>
