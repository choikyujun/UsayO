<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="horizontal" android:gravity="center_vertical"
  android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="9dp" android:paddingBottom="5dp">
  <TextView android:id="@+id/day_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:textSize="13.5sp" android:textStyle="bold" android:textColor="#8A86A3" />
  <ImageView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"
    android:layout_marginStart="7dp" android:background="#1226215C" />
</LinearLayout>
