EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# OPENAI / ANTHROPIC 키는 클라이언트에서 제거됨 → Supabase Edge Function secret으로 이관.
#   stt-proxy: OPENAI_API_KEY (서버 secret) / intent-proxy: ANTHROPIC_API_KEY (서버 secret)
#   supabase secrets set OPENAI_API_KEY=... ANTHROPIC_API_KEY=...
# 결제는 RevenueCat → react-native-iap(스토어 직접 연동)로 전환됨. 클라이언트 키가 필요 없다.
#   구매 검증은 서버 secret으로 동작: GOOGLE_SERVICE_ACCOUNT_JSON / ANDROID_PACKAGE_NAME
#   (+ RTDN_PUSH_AUDIENCE / RTDN_PUSH_SA_EMAIL)
#   supabase secrets set GOOGLE_SERVICE_ACCOUNT_JSON=...
